# =============================================================================
#  .env.example — Template konfigurasi untuk Polymarket NegRisk Split Bot
# =============================================================================
#
#  CARA PAKAI:
#    1. Salin file ini:  cp .env.example .env
#    2. Isi setiap nilai di bawah ini pada file .env
#    3. JANGAN commit file .env ke git!
#       Pastikan baris ".env" ada di .gitignore Anda.
#
# =============================================================================

# ─── Private Key Wallet ───────────────────────────────────────────────────────
# Format wajib: "0x" diikuti tepat 64 karakter hexadecimal
# Cara export: MetaMask → ⋮ → Account Details → Export Private Key
# PERINGATAN: Siapapun yang memiliki private key ini dapat menguras wallet Anda!
PRIVATE_KEY=0x_ganti_dengan_private_key_64_karakter_hex_anda

# ─── RPC URL Polygon Mainnet ──────────────────────────────────────────────────
# Rekomendasi (gratis, stabil):
#   Alchemy  : https://dashboard.alchemy.com/  → Create App → Polygon
#   QuickNode: https://www.quicknode.com/       → Create Endpoint → Polygon
# Publik (kadang rate-limited, OK untuk testing):
#   https://polygon-rpc.com
#   https://rpc-mainnet.matic.network
# Opsi 1 — Gratis, tidak perlu daftar:
POLYGON_RPC_URL=https://1rpc.io/matic
# Opsi 2 — Alchemy (lebih andal, daftar di alchemy.com):
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/GANTI_DENGAN_API_KEY_ALCHEMY

# ─── Data Pasar Target ────────────────────────────────────────────────────────
# NegRisk Market ID (bytes32) — ID induk pasar, bukan conditionId CTF
# Contoh di bawah adalah pasar "Elon Musk Tweets April 7-14"
NEG_RISK_MARKET_ID=0x11ab331c7409a321ec3cd9df51b40488b498bf01c8bd71e9ac64e0786be38700

# Slug pasar untuk pencarian via Gamma API
# Cari di URL pasar Polymarket: polymarket.com/event/<SLUG-DI-SINI>
MARKET_SLUG=elon-musk-of-tweets-april-7-april-14

# ─── Konfigurasi Split ────────────────────────────────────────────────────────
# Jumlah USDC.e yang di-split PER KONDISI (satuan: USDC, bukan wei)
# Total USDC yang dibutuhkan = SPLIT_AMOUNT_USDC x MAX_CONDITIONS
# Contoh: 5 x 30 = 150 USDC.e total
SPLIT_AMOUNT_USDC=5

# Batas maksimum kondisi yang diproses dalam satu run
# Kurangi untuk testing (misal: 3) sebelum menjalankan untuk semua 30 kondisi
MAX_CONDITIONS=30

# ─── Polymarket API Keys (OPSIONAL) ──────────────────────────────────────────
# Diperlukan HANYA jika Anda ingin menggunakan fitur CLOB order management
# (bukan untuk splitPosition — split berjalan on-chain tanpa API key)
# Dapatkan di: polymarket.com → Profile → API Keys
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
